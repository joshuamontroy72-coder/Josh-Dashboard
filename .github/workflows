name: Refresh Dashboard Data

on:
  schedule:
    - cron: '0 11 * * *' # Runs daily at 11:00 AM UTC (7:00 AM Ottawa time)
  workflow_dispatch: # Adds a manual "Run" button to the web interface

jobs:
  refresh:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          pip install requests pandas  # Add any other libraries your script uses here

      - name: Run data cleaning pipeline
        run: python pipeline.py

      - name: Commit and push updated data
        run: |
          git config --global user.name "GitHub Action"
          git config --global user.email "actions@github.com"
          git add data.json
          git commit -m "Auto-updated tracking data via cloud pipeline" || exit 0
          git push
