                    className="px-2 py-1 text-[10px] font-bold uppercase tracking-wide rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 focus:outline-none focus:border-indigo-400 shadow-sm"
