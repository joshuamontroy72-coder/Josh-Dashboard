                  <div className="bg-red-500 p-4 rounded-2xl shadow-lg shadow-red-100 dark:shadow-none text-white">
                    <span className="text-[9px] font-black opacity-70 uppercase tracking-widest block mb-1">Important</span>
                    <span className="text-2xl font-bold">
                      {stats.importantFiltered}/{stats.importantTotal}
                    </span>
                   </div>
                </div>

                <div className="grid grid-cols-1 md:grid-cols-2 gap-4 h-[400px]">
                  <div className="bg-slate-900 rounded-2xl p-4 flex flex-col font-mono text-[11px] border border-slate-800 shadow-inner">
                    <div className="flex justify-between items-center text-emerald-400 mb-3 border-b border-slate-800 pb-2">
                      <span className="font-black uppercase flex items-center gap-2">
                        <TerminalSquare className="w-4 h-4" /> Server Trace Log
                      </span>
                      <span className="opacity-50 text-[9px]">{scanLog.length} events</span>
                    </div>
                    <div className="flex-1 overflow-y-auto custom-scrollbar-dark pr-2">
                      {scanLog.map((l) => (
                        <div key={l.id} className="mb-2 text-slate-400 leading-relaxed flex items-start gap-1.5 text-[10px]">
                          <span className="text-slate-600 shrink-0">[{l.time}]</span>
                          <div className="mt-0.5 shrink-0 flex items-center justify-center w-3 h-3">
                            {l.type === 'success' && <Check className="w-3 h-3 text-emerald-500" strokeWidth={3} />}
                            {l.type === 'error' && <XCircle className="w-3 h-3 text-red-500" />}
                            {l.type === 'info' && <div className="w-1.5 h-1.5 bg-blue-500 rounded-full"></div>}
                          </div>
                          <div className="flex-1">
                            {l.name && <span className="text-slate-100 font-bold">{String(l.name)}: </span>}
                            <span className={l.type === 'error' ? 'text-red-400' : l.type === 'success' ? 'text-emerald-400/80' : 'text-slate-300'}>
                              {String(l.msg)}
