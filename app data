 const facetCounts = useMemo(() => {
    const disease = Object.fromEntries(CANADIAN_VPDS.map((d) => [d, 0]));
    const topic = { ...Object.fromEntries(Object.keys(TOPIC_MAP).map((t) => [t, 0])), 'Other Topics': 0 };

    for (const a of timeFilteredArticles) {
      const riskOk = !isImportantOnly || a.meta?.isImportant;
      if (!riskOk) continue; // Skip entirely if filtered out

      // Pathogen Math
      if (matchesTopic(a, selectedTopic)) {
        disease.All += 1;
        let matchedSpecificDisease = false;
        let addedUnknownOther = false;

        for (const tag of a.tags || []) {
          if (tag === 'Unknown' || tag === 'Other' || tag === 'Unclassified') {
            if (!addedUnknownOther) {
              disease['Unknown/Other'] += 1;
              addedUnknownOther = true;
            }
          } else if (disease[tag] !== undefined) {
            disease[tag] += 1;
            matchedSpecificDisease = true;
          }
        }
        
        if (!matchedSpecificDisease && !addedUnknownOther) {
          disease['Unknown/Other'] += 1;
        }
      }

      // Topic Math
      if (matchesDisease(a, selectedDisease)) {
        let matchedAnyTopic = false;
        for (const t of Object.keys(TOPIC_MAP)) {
          if (matchesTopic(a, t)) {
            topic[t] += 1;
            if (t !== 'All Topics') matchedAnyTopic = true;
          }
        }
        if (!matchedAnyTopic) {
           topic['Other Topics'] += 1;
        }
      }
    }
    return { disease, topic };
  }, [timeFilteredArticles, isImportantOnly, selectedTopic, selectedDisease]);

  const handleExportCSV = () => {
    const headers = Object.keys(exportFields).filter(f => exportFields[f]);
    const lines = [
      headers.join(','),
      ...filteredArticles.map(a =>
        headers.map(h => {
          if (h === 'date') return safeCsvCell(a.publishedAt ? new Date(a.publishedAt).toLocaleDateString() : '');
          if (h === 'tags') return safeCsvCell((a.tags || []).join(', '));
