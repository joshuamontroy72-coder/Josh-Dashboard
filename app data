              </div>
            ) : (
              <div className="grid grid-cols-1 xl:grid-cols-2 gap-4 md:gap-6 max-w-6xl mx-auto pb-20">
                {filteredArticles.length > 0 ? (
                  filteredArticles.map((article) => (
                    <ArticleCard 
                      key={article.id} 
                      article={article} 
                      onSearchClick={setActiveQuery} 
                    />
                  ))
                ) : (
                  <div className="col-span-full py-32 flex flex-col items-center opacity-40">
                    <Newspaper className="w-16 h-16 mb-4 text-slate-300 dark:text-slate-700" />
                    <span className="text-[11px] font-black uppercase tracking-widest text-slate-400 dark:text-slate-600">
                      {isFetching ? 'Fetching Database...' : 'Feed Silent'}
                    </span>
                  </div>
                )}
              </div>
            )}
          </div>
          
          {/* EXPORT MODAL */}
          {isExportModalOpen && (
            <div className="absolute inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4 animate-in fade-in duration-200">
              <div className="bg-white dark:bg-slate-900 rounded-2xl shadow-2xl w-full max-w-sm overflow-hidden flex flex-col animate-in zoom-in-95 duration-200 border border-slate-200 dark:border-slate-800">
                <div className="p-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-slate-50 dark:bg-slate-900">
                  <h3 className="font-black text-slate-700 dark:text-slate-200 uppercase tracking-widest text-xs flex items-center gap-2">
                    <Download className="w-4 h-4 text-indigo-500" /> Configure Export
                  </h3>
                  <button onClick={() => setIsExportModalOpen(false)} className="text-slate-400 hover:text-red-500 transition-colors">
                    <XCircle className="w-5 h-5" />
                  </button>
                </div>
                <div className="p-6 grid grid-cols-2 gap-y-4 gap-x-2">
                  {Object.keys(exportFields).map(key => (
                    <label key={key} className="flex items-center gap-2.5 text-xs font-bold text-slate-600 dark:text-slate-300 cursor-pointer group">
                      <div className="relative flex items-center justify-center">
                        <input 
                          type="checkbox" 
                          checked={exportFields[key]} 
                          onChange={() => setExportFields(p => ({ ...p, [key]: !p[key] }))} 
                          className="peer appearance-none w-4 h-4 border-2 border-slate-300 dark:border-slate-600 rounded bg-white dark:bg-slate-800 checked:bg-indigo-500 dark:checked:bg-indigo-500 transition-all cursor-pointer" 
                        />
                        <Check className="w-3 h-3 text-white absolute pointer-events-none opacity-0 peer-checked:opacity-100" strokeWidth={3} />
                      </div>
                      <span className="capitalize group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">{key.replace(/([A-Z])/g, ' $1').trim()}</span>
                    </label>
                  ))}
                </div>
                <div className="p-4 border-t border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 flex justify-end gap-2">
                  <button onClick={() => setIsExportModalOpen(false)} className="px-4 py-2 rounded-xl text-xs font-bold text-slate-500 dark:text-slate-400 hover:bg-slate-200/50 dark:hover:bg-slate-800 transition-colors">Cancel</button>
                  <button onClick={handleExportCSV} className="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2 rounded-xl text-xs font-bold shadow-sm shadow-indigo-200 dark:shadow-none transition-colors flex items-center gap-2">
                    Download CSV
                  </button>
                </div>
              </div>
            </div>
          )}
        </main>

        {/* RIGHT SIDEBAR (Topics & AI Feed) */}
        <aside className="w-[240px] bg-[#0B1120] text-gray-300 flex-col h-full border-l border-gray-800 flex overflow-hidden shrink-0 hidden lg:flex">
          
          {/* TAB TOGGLES */}
          <div className="flex border-b border-gray-800 bg-[#0B1120] shrink-0">
            <button 
              onClick={() => setRightTab('topics')}
              className={`flex-1 py-3 text-[10px] font-black uppercase tracking-widest transition-colors ${rightTab === 'topics' ? 'text-blue-400 border-b-2 border-blue-500' : 'text-slate-500 hover:text-slate-300'}`}
            >
              <Globe className="w-3.5 h-3.5 inline mr-1.5 mb-0.5" /> Topics
            </button>
            <button 
              onClick={() => setRightTab('ai')}
              className={`flex-1 py-3 text-[10px] font-black uppercase tracking-widest transition-colors ${rightTab === 'ai' ? 'text-emerald-400 border-b-2 border-emerald-500' : 'text-slate-500 hover:text-slate-300'}`}
            >
              🤖 AI Search
            </button>
          </div>

          <div className="flex-1 overflow-y-auto p-3 space-y-1 custom-scrollbar-dark">
{/* VIEW 1: TOPICS */}
            {rightTab === 'topics' && [...Object.keys(TOPIC_MAP), 'Other Topics']
              .filter(t => t !== 'Systematic Reviews') // Hide from the main flat list
              .map((t) => {
                const isPeerReviewed = t === 'Peer-reviewed';
                const isOpen = openSections['peer_reviewed_group'];

                return (
                  <React.Fragment key={t}>
                    <button
                      onClick={() => {
                        setSelectedTopic(t);
                        if (isPeerReviewed) toggleSection('peer_reviewed_group');
                      }}
                      className={`w-full text-left px-3 py-2 rounded-xl text-[11px] font-bold transition-all flex justify-between items-center ${
                        selectedTopic === t ? 'bg-blue-600 text-white' : 'hover:bg-slate-700 text-slate-300'
                      }`}
                    >
                      <div className="flex items-center gap-1.5 truncate">
                        {isPeerReviewed && (
                          isOpen ? <ChevronDown className="w-3 h-3 text-slate-400 shrink-0" /> : <ChevronRight className="w-3 h-3 text-slate-400 shrink-0" />
                        )}
                        <span className="truncate pr-1">{t}</span>
                      </div>
                      <span className="text-[9px] bg-white/10 px-1.5 py-0.5 rounded-md min-w-[20px] text-center">
                        {facetCounts.topic[t] || 0}
                      </span>
                    </button>

                    {/* The Collapsible Subtab */}
                    {isPeerReviewed && isOpen && (
                      <div className="pl-3 animate-in slide-in-from-top-2 duration-200 mt-1">
                        <button
                          onClick={() => setSelectedTopic('Systematic Reviews')}
                          className={`w-full text-left px-3 py-2 rounded-xl text-[11px] font-bold transition-all flex justify-between items-center ${
                            selectedTopic === 'Systematic Reviews' ? 'bg-blue-600 text-white' : 'hover:bg-slate-800 text-slate-400'
                          }`}
                        >
                          <span className="truncate pr-1">↳ Systematic Reviews</span>
                          <span className="text-[9px] bg-slate-800/80 px-1.5 py-0.5 rounded-md min-w-[20px] text-center">
                            {facetCounts.topic['Systematic Reviews'] || 0}
                          </span>
                        </button>
                      </div>
                    )}
                  </React.Fragment>
                );
            })}

            {/* VIEW 2: AI FEED */}
            {rightTab === 'ai' && (
              <div className="space-y-3">
                {articles.filter(a => (a.tags || []).includes('🤖 AI Insight')).length > 0 ? (
                  articles.filter(a => (a.tags || []).includes('🤖 AI Insight')).map((aiArticle, idx) => (
                    <div key={idx} className="bg-slate-800/50 p-3 rounded-xl border border-slate-700/50 hover:border-emerald-500/50 transition-colors">
                      <a href={aiArticle.url} target="_blank" rel="noopener noreferrer" className="text-[11px] font-bold text-slate-200 block mb-1.5 hover:text-emerald-400">
                        {aiArticle.title}
                      </a>
                      <p className="text-[10px] text-slate-400 line-clamp-4 leading-relaxed">
                        {aiArticle.summary}
                      </p>
                      <div className="mt-2 flex flex-wrap gap-1">
                       {(aiArticle.tags || []).map(tag => (
                          <span key={tag} className="text-[8px] uppercase font-black bg-slate-900 text-slate-400 px-1.5 py-0.5 rounded border border-slate-700">
                            {tag}
                          </span>
                        ))}
                      </div>
                    </div>
                  ))
                ) : (
                  <div className="text-center py-10 opacity-50">
                    <span className="text-[10px] uppercase font-black tracking-widest block mb-2">No AI Results</span>
                    <span className="text-[9px]">Run your ChatGPT agent to populate this feed.</span>
                  </div>
                )}
              </div>
            )}
          </div>
        </aside>
      </div>

      <style
        dangerouslySetInnerHTML={{
          __html: `
        .custom-scrollbar-dark::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar-dark::-webkit-scrollbar-thumb { background: #475569; border-radius: 10px; }
        .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }        
      `,
        }}
      />
    </div>
  );
}
