              <Microscope className="w-3.5 h-3.5" /> Pathogens
            </h3>
            <button className="md:hidden text-slate-400" onClick={() => setIsMobileMenuOpen(false)}>
              <X className="w-4 h-4" />
            </button>
          </div>
          <div className="space-y-1">
            {CANADIAN_VPDS.map((d) => (
              <button
                key={d}
                onClick={() => { setSelectedDisease(d); setIsMobileMenuOpen(false); }}
                className={`w-full text-left px-3 py-2 rounded-xl text-[11px] font-bold transition-all flex justify-between items-center ${
                  selectedDisease === d ? 'bg-blue-600 text-white' : 'hover:bg-slate-700 text-slate-300'
                }`}
              >
                <span className="truncate pr-1">{d}</span>
                <span className="text-[9px] bg-white/10 px-1.5 py-0.5 rounded-md min-w-[20px] text-center">
                  {facetCounts.disease[d] || 0}
                </span>
              </button>
            ))}
          </div>
        </aside>

        <main className="flex-1 flex flex-col h-full relative w-full overflow-hidden">
          <header className="px-4 py-2.5 border-b border-slate-100 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 bg-white dark:bg-slate-900 z-10 w-full relative">
            
            <div className="flex items-center gap-2">
              <button 
                className="md:hidden p-1.5 bg-slate-100 dark:bg-slate-800 rounded-lg text-slate-600 dark:text-slate-300"
                onClick={() => setIsMobileMenuOpen(true)}
              >
                <Menu className="w-4 h-4" />
              </button>
              
              <div className="bg-slate-50 dark:bg-slate-800/50 p-0.5 rounded-lg flex border border-slate-100 dark:border-slate-700 shadow-sm">
                {['Today', 'Last Week', 'Last Two Weeks', 'Custom'].map((t) => (
                  <button
