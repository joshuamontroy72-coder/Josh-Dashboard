import React, { useState, useEffect, useMemo, useCallback } from 'react';
import {
  Newspaper, Activity, XCircle, Globe, ShieldAlert, Microscope,
  Download, Check, TerminalSquare, Moon, Sun, Menu, X,
  ChevronDown, ChevronRight
} from 'lucide-react';
import { TOPIC_MAP, CANADIAN_VPDS } from './constants';
import ArticleCard from './ArticleCard';

const safeCsvCell = (value) => {
  const s = String(value ?? '');
  const escaped = s.replace(/"/g, '""');
  const formulaRisk = /^[=+\-@]/.test(escaped);
  return `"${formulaRisk ? "'" : ""}${escaped}"`;
};

const matchesTime = (a, tf, nowMs, customRange) => {
  const pub = Number.isFinite(a.publishedAt) ? a.publishedAt : 0;
  if (!pub) return tf !== 'Custom';
if (tf === 'Custom' && customRange?.start) {
    const start = new Date(customRange.start + 'T00:00:00').getTime();
    const end = customRange.end ? new Date(customRange.end + 'T00:00:00').getTime() + 86400000 : nowMs;
    return pub >= start && pub <= end;
  }
  const age = nowMs - pub;
  if (tf === 'Today') return age <= 86400000;
  if (tf === 'Last Week') return age <= 604800000;
  if (tf === 'Last Two Weeks') return age <= 1209600000;
  return true;
};

const matchesDisease = (a, sd) => {
  if (sd === 'All') return true;

  const hasExplicitUnknown = (a.tags || []).some(t => t === 'Unknown' || t === 'Other' || t === 'Unclassified');
  const specificDiseases = CANADIAN_VPDS.filter(d => d !== 'All' && d !== 'Unknown/Other');
  const hasSpecificDisease = (a.tags || []).some(t => specificDiseases.includes(t));

  if (sd === 'Unknown/Other') {
    return hasExplicitUnknown || !hasSpecificDisease;
  }

  return (a.tags || []).includes(sd);
};

const matchesTopic = (a, st) => {
  const lowerTags = (a.tags || []).map(t => String(t).toLowerCase());

  // 1. SMART EPI SUPPRESSION
  if (
    lowerTags.includes('epidemiology') && 
    !lowerTags.includes('study') && 
    !lowerTags.includes('preprint') &&
    !lowerTags.includes('clinical trial') &&
    !lowerTags.includes('⭐ pubmed')
  ) {
    return false;
  }

  const checkTopic = (topicName) => {
    if (topicName === 'Canada') return Boolean(a.meta?.isCanadian);
    if (topicName === 'PHEIC') return Boolean(a.meta?.isPHEIC); 
    if (topicName === 'Regulatory') {
      const isBlocked = lowerTags.some(t => t === 'translate' || t === 'translation' || t === 'portuguese' || t === 'medrxiv' || t === 'biorxiv');
      if (isBlocked) return false;
    }
    if (topicName === 'Guidelines') {
      const isPreprint = lowerTags.some(t => t === 'medrxiv' || t === 'biorxiv');
      if (isPreprint) return false;
    }
    const neededTags = TOPIC_MAP[topicName];
    return Array.isArray(neededTags) ? neededTags.some((t) => (a.tags || []).includes(t)) : false;
  };

  // 2. Catch-all for "Other Topics"
  if (st === 'Other Topics') {
    const knownTopics = Object.keys(TOPIC_MAP).filter(k => k !== 'All Topics');
    return !knownTopics.some(checkTopic);
  }

  if (st === 'All Topics') return true;
  return checkTopic(st);
};

