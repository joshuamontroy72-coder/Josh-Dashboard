                  onChange={(e) => setSearchInput(e.target.value)}
                  onKeyDown={handleSearchEnter}
                  className="px-2.5 py-1 text-[10px] font-medium rounded-lg border border-slate-200 dark:border-slate-700 focus:outline-none focus:border-indigo-400 bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 w-full placeholder-slate-400 transition-colors shadow-sm pr-6"
                />
