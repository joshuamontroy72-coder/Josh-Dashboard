                      <button
                        onClick={handleCopyErrors}
                        className="bg-red-500 hover:bg-red-400 text-white px-2 py-0.5 rounded text-[9px] font-black uppercase transition-colors"
                      >
                        {copied ? 'Copied' : 'Copy'}
                      </button>
                    </div>
                    <div className="flex-1 overflow-y-auto custom-scrollbar-dark pr-2">
                      {scanLog.filter((l) => l.type === 'error').map((l) => (
                        <div key={l.id} className="mb-2 text-red-200/60 leading-relaxed">
