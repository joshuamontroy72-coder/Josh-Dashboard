      setActiveQuery(searchInput);
      setSearchInput('');
    }
  };

  const handleClearSearch = () => {
    setSearchInput('');
    setActiveQuery('');
  };

  const timeFilteredArticles = useMemo(() => {
    return articles.filter(a => matchesTime(a, timeframe, nowMs, customDateRange));
  }, [articles, timeframe, customDateRange, nowMs]);

const filteredArticles = useMemo(() => {
    const searchLower = activeQuery.toLowerCase();
    
    // 1. Filter the articles first
    const filtered = timeFilteredArticles.filter((a) => {
      if (!matchesDisease(a, selectedDisease)) return false;
      if (!matchesTopic(a, selectedTopic)) return false;
      if (isImportantOnly && !a.meta?.isImportant) return false;
      if (activeQuery && !`${a.title} ${a.summary} ${a.sourceName} ${(a.tags || []).join(' ')}`.toLowerCase().includes(searchLower)) return false;
      return true;
    });

    // 2. Force strict chronological sorting (MOST RECENT FIRST)
    return filtered.sort((a, b) => {
      const dateA = Number(a.publishedAt) || 0;
      const dateB = Number(b.publishedAt) || 0;
      
      if (dateA > dateB) return -1;
      if (dateA < dateB) return 1;
      return 0;
    });
    
