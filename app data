                    <span className="text-[9px] font-black text-slate-400 uppercase tracking-widest block mb-1">Database Age</span>
                    <span className={`text-xl font-bold ${!lastUpdated ? 'text-slate-400' : 'text-emerald-500'}`}>
                      {lastUpdated ? new Date(lastUpdated).toLocaleTimeString() : 'N/A'}
                    </span>
                  </div>
                  <div className="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm">
                    <span className="text-[9px] font-black text-slate-400 uppercase tracking-widest block mb-1">Backend Hooks</span>
